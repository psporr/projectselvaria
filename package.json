{
  "name": "project-selvaria",
  "private": true,
  "version": "0.31.0",
  "description": "A 2D tactical RPG in the Fire Emblem lineage, built on Phaser 4 + TypeScript + Vite + boardgame.io.",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "sim": "tsx src/scripts/simulate.ts",
    "validate-maps": "tsx src/scripts/validateMaps.ts",
    "scan-atlas": "tsx src/scripts/scanSpriteAtlas.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "phaser": "^4.2.1",
    "terser": "^5.39.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  }
}
